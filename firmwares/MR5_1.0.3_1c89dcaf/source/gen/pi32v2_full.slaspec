# ---- branch-target subtables ----
bt0: res is s16_4_6 & u16_8_12
	[ res = (((s16_4_6 << 5) | u16_8_12) * 2) + inst_next; ]
	{ export *:4 res; }

bt1: res is s16_0_1 & u16_4_7 & u16_8_12
	[ res = (((s16_0_1 << 9) | (u16_4_7 << 5) | u16_8_12) * 2) + inst_next; ]
	{ export *:4 res; }

bt2: res is s16_0_5 ; u16w1_0_15
	[ res = (((s16_0_5 << 16) | u16w1_0_15) * 2) + inst_next; ]
	{ export *:4 res; }

bt3: res is s16_0_5 ; u16w1_0_15
	[ res = (((s16_0_5 << 16) | u16w1_0_15) * 2) + inst_next; ]
	{ export *:4 res; }

bt5: res is s16w1_0_8
	[ res = ((s16w1_0_8) * 2) + inst_next; ]
	{ export *:4 res; }

bt6: res is s16w1_0_15
	[ res = ((s16w1_0_15) * 2) + inst_next; ]
	{ export *:4 res; }

bt7: res is s16w2_0_15
	[ res = ((s16w2_0_15) * 2) + inst_next; ]
	{ export *:4 res; }

bt8: res is u16w1_1_15 ; s16w2_0_15
	[ res = (((s16w2_0_15 << 15) | u16w1_1_15) * 2) + inst_next; ]
	{ export *:4 res; }

bt9: res is u16w1_1_15 ; s16w2_0_15
	[ res = (((s16w2_0_15 << 15) | u16w1_1_15) * 2) + inst_next; ]
	{ export *:4 res; }

rs4: "r0" is rsp_b_16_7_8=0x0 & rsp_b_16_3_3=0x0 { export r0; }
rs4: "r1" is rsp_b_16_7_8=0x0 & rsp_b_16_3_3=0x1 { export r1; }
rs4: "r2" is rsp_b_16_7_8=0x1 & rsp_b_16_3_3=0x0 { export r2; }
rs4: "r3" is rsp_b_16_7_8=0x1 & rsp_b_16_3_3=0x1 { export r3; }
rs4: "r4" is rsp_b_16_7_8=0x2 & rsp_b_16_3_3=0x0 { export r4; }
rs4: "r5" is rsp_b_16_7_8=0x2 & rsp_b_16_3_3=0x1 { export r5; }
rs4: "r6" is rsp_b_16_7_8=0x3 & rsp_b_16_3_3=0x0 { export r6; }
rs4: "r7" is rsp_b_16_7_8=0x3 & rsp_b_16_3_3=0x1 { export r7; }


# ---- instructions ----
# nop | control | Do nothing.
:"nop" is c16_0_15=0x0
{ }

# idle | control | Wait for an interrupt.
:"idle" is c16_0_15=0x1
{ }

# csync | control | Core synchronisation barrier.
:"csync" is c16_0_15=0x20
{ }

# cli | control | Disable interrupts.
:"cli" is c16_0_15=0x60
{ }

# sti | control | Enable interrupts.
:"sti" is c16_0_15=0x61
{ }

# rts | returns | Return from a subroutine: continue at the address in rets.
:"rts" is c16_0_15=0x80
{
	return [rets];
}

# rti | returns | Return from an interrupt: continue at the address in reti.
:"rti" is c16_0_15=0x81
{
	return [reti];
}

# rtx | returns | Return from an exception: continue at the address in retx.
:"rtx" is c16_0_15=0x82
{
	return [retx];
}

# rte | returns | Return from emulation (debug) mode: continue at the address in rete.
:"rte" is c16_0_15=0x83
{
	return [rete];
}

# call.r | jumps | Call the subroutine at the address in a register; the return address goes to rets.
:"call "^gpr_16_0_3 is c16_4_15=0xc & gpr_16_0_3
{
	call [gpr_16_0_3];
}

# goto.r | jumps | Jump to the address in a register.
:"goto "^gpr_16_0_3 is c16_4_15=0xd & gpr_16_0_3
{
	goto [gpr_16_0_3];
}

# mov.rr | moves | Copy one general register to another.
:""^gpr_16_0_3^" = "^gpr_16_4_7 is c16_8_15=0x16 & gpr_16_0_3 & gpr_16_4_7
{
	gpr_16_0_3 = gpr_16_4_7;
}

# mov.sp_usp | moves | Make the user stack pointer the current stack pointer.
:"sp = usp" is c16_0_15=0x1440
{
	sp = usp;
}

# mov.sp_ssp | moves | Make the supervisor stack pointer the current stack pointer.
:"sp = ssp" is c16_0_15=0x1441
{
	sp = ssp;
}

# mov.usp_sp | moves | Save the current stack pointer as the user stack pointer.
:"usp = sp" is c16_0_15=0x1442
{
	usp = sp;
}

# mov.ssp_sp | moves | Save the current stack pointer as the supervisor stack pointer.
:"ssp = sp" is c16_0_15=0x1443
{
	ssp = sp;
}

# cc.set | moves | Set the carry flag (psr bit 1) to 0 or 1.
:"cc = "^u16_0_0 is c16_1_15=0xa00 & u16_0_0
{
	local tpc1:4 = 0:4; tpc1 = u16_0_0; psr = tpc1;
}

# mov.r_sr | moves | Copy a special register to a general register.
:""^gpr_16w1_12_15^" = "^nsr_16w1_8_11 is c16_0_15=0xe064 ; c16w1_0_7=0x0 & gpr_16w1_12_15 & nsr_16w1_8_11
{
	gpr_16w1_12_15 = nsr_16w1_8_11;
}

# mov.sr_r | moves | Copy a general register to a special register.
:""^nsr_16w1_8_11^" = "^gpr_16w1_12_15 is c16_0_15=0xe064 ; c16w1_0_7=0x80 & nsr_16w1_8_11 & gpr_16w1_12_15
{
	nsr_16w1_8_11 = gpr_16w1_12_15;
}

# trigger | control | Purpose unknown; used by the FM-1 firmware's second-core start-up.
:"trigger" is c16_0_15=0xe870 ; c16w1_0_15=0x0
{ }

# li.u8 | constants | Load a constant 0..255 into r0..r7.
:""^gpr_lo_16_0_2^" = "^o_n is c16_13_15=0x1 & c16_6_7=0x1 & gpr_lo_16_0_2 & u16_3_5 & u16_8_12 [ o_n = (u16_3_5 << 5) | u16_8_12; ]
{
	local tpc1:4 = 0:4; tpc1 = o_n; gpr_lo_16_0_2 = tpc1;
}

# li.neg5 | constants | Load a constant -32..-1 into r0..r7.
:""^gpr_lo_16_0_2^" = "^o_n is c16_13_15=0x1 & c16_3_7=0x2 & gpr_lo_16_0_2 & u16_8_12 [ o_n = (u16_8_12) + (-32); ]
{
	local tpc1:4 = 0:4; tpc1 = o_n; gpr_lo_16_0_2 = tpc1;
}

# li.zero_hi | constants | Clear one of r8..r15.
:""^gpr_hi_16_0_2^" = 0" is c16_3_15=0x298 & gpr_hi_16_0_2
{
	gpr_hi_16_0_2 = 0:4;
}

# li.modimm | constants | Load a 32-bit constant given by a 12-bit modified immediate (any register).
:""^gpr_16w1_12_15^" = "^nmi00_16w1_0_11 is c16_0_15=0xe060 ; gpr_16w1_12_15 & nmi00_16w1_0_11 & mival00_16w1_0_11
{
	local tpc1:4 = 0:4; tpc1 = mival00_16w1_0_11; gpr_16w1_12_15 = tpc1;
}

# li.s16 | constants | Load a signed 16-bit constant (any register).
:""^gpr_16_0_3^" = "^s16w1_0_15 is c16_4_15=0xe04 & gpr_16_0_3 ; s16w1_0_15
{
	local tpc1:2 = 0:2; local tpc2:4 = 0:4; tpc1 = s16w1_0_15; tpc2 = sext(tpc1); gpr_16_0_3 = tpc2;
}

# li.u32 | constants | Load any 32-bit constant or the address of a symbol (48-bit instruction; the low half comes first).
:""^gpr_16_0_3^" = "^o_n is c16_4_15=0xffc & gpr_16_0_3 ; u16w1_0_15 ; u16w2_0_15 [ o_n = (u16w2_0_15 << 16) | u16w1_0_15; ]
{
	local tpc1:4 = 0:4; tpc1 = o_n; gpr_16_0_3 = tpc1;
}

# li.sr_u32 | constants | Load a 32-bit constant into a special register; the low half comes first in memory.
:""^nsr_16_0_3^" = "^o_n is c16_4_15=0xffe & nsr_16_0_3 ; u16w1_0_15 ; u16w2_0_15 [ o_n = (u16w2_0_15 << 16) | u16w1_0_15; ]
{
	local tpc1:4 = 0:4; tpc1 = o_n; nsr_16_0_3 = tpc1;
}

# or.bit | constants | Set a single bit: rd |= 1 << n (r0..r7).
:""^gpr_lo_16_0_2^" |= "^nbit_16_8_12 is c16_13_15=0x1 & c16_3_7=0x6 & gpr_lo_16_0_2 & nbit_16_8_12 & vbit_16_8_12
{
	local tpc1:4 = 0:4; tpc1 = vbit_16_8_12; gpr_lo_16_0_2 = gpr_lo_16_0_2 | tpc1;
}

# ld.w.sp | memory | Load a word from the stack at sp plus 0..252.
:""^gpr_16_0_3^" = [sp"^"+"^o_n^"]" is c16_13_15=0x1 & c16_6_7=0x0 & c16_4_4=0x0 & gpr_16_0_3 & u16_5_5 & u16_8_12 [ o_n = ((u16_5_5 << 5) | u16_8_12) * 4; ]
{
	local tpc1:4 = 0:4; local tpc2:4 = 0:4; tpc1 = o_n; tpc2 = *:4 (sp + tpc1); gpr_16_0_3 = tpc2;
}

# st.w.sp | memory | Store a word to the stack at sp plus 0..252.
:"[sp"^"+"^o_n^"] = "^gpr_16_0_3 is c16_13_15=0x1 & c16_6_7=0x2 & c16_4_4=0x0 & u16_5_5 & u16_8_12 & gpr_16_0_3 [ o_n = ((u16_5_5 << 5) | u16_8_12) * 4; ]
{
	local tpc1:4 = 0:4; tpc1 = o_n; *:4 (sp + tpc1) = gpr_16_0_3;
}

# ld.w | memory | Load a word from memory at r0..r7 plus -64..60.
:""^gpr_lo_16_0_2^" = ["^gpr_lo_16_4_6^"+"^o_n^"]" is c16_13_15=0x3 & c16_7_7=0x0 & c16_3_3=0x0 & gpr_lo_16_0_2 & gpr_lo_16_4_6 & s16_8_12 [ o_n = (s16_8_12) * 4; ]
{
